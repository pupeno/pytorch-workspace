{
    "name": "pytorch",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",

    "features": {
        // Install node.
        "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
        // Install the GitHub CLI.
        "ghcr.io/devcontainers/features/github-cli:1": {},
        // Needed for lintrunner.
        "ghcr.io/devcontainers/features/rust:1": {},
        // Install a CUDA 13.2 toolkit and its matching cuDNN runtime and headers.
        "ghcr.io/devcontainers/features/nvidia-cuda:3": {
            "installToolkit": true,
            "cudaVersion": "13.2",
            "installCudnn": true,
            "installCudnnDev": true
        }
    },

    // Fixes the hostname so shell prompts and logs identify the container, and
    // exposes the host GPU(s) inside it.
    "runArgs": ["--hostname", "pytorch", "--runtime", "nvidia", "--gpus", "all"],

    "mounts": [
        // One volume for the whole container home so all config survive a rebuild.
        "source=pytorch-home,target=/home/vscode,type=volume"
    ],

    // Make CUDA discoverable to terminals, editor tasks, and extension builds.
    "remoteEnv": {
        "CUDA_HOME": "/usr/local/cuda",
        "PATH": "/usr/local/cuda/bin:${containerEnv:PATH}",
        // Cap parallel build jobs so PyTorch compiles don't exhaust RAM.
        "MAX_JOBS": "8"
    },

    // Runs the post-create script to set up the container.
    "postCreateCommand": ".devcontainer/post-create.sh",

    // Connect to the devcontainer as non-root.
    // It allows Claude Code run with --dangerously-skip-permissions.
    "remoteUser": "vscode"
}
